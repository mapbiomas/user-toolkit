<?xml version="1.0" encoding="UTF-8"?>
<sld:StyledLayerDescriptor version="1.0.0"
    xmlns:sld="http://www.opengis.net/sld"
    xmlns:ogc="http://www.opengis.net/ogc"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.0.0/StyledLayerDescriptor.xsd">
  <sld:NamedLayer>
    <sld:Name>MapBiomas Fire indonesia C1 - month of burn</sld:Name>
    <sld:UserStyle>
      <sld:Name>MapBiomas Fire indonesia C1 - month of burn</sld:Name>
      <sld:FeatureTypeStyle>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#a900ff" quantity="1" label="January" opacity="1"/>
              <sld:ColorMapEntry color="#6f02ff" quantity="2" label="February" opacity="1"/>
              <sld:ColorMapEntry color="#020aff" quantity="3" label="March" opacity="1"/>
              <sld:ColorMapEntry color="#0675ff" quantity="4" label="April" opacity="1"/>
              <sld:ColorMapEntry color="#06ffff" quantity="5" label="May" opacity="1"/>
              <sld:ColorMapEntry color="#ffee00" quantity="6" label="June" opacity="1"/>
              <sld:ColorMapEntry color="#ff7700" quantity="7" label="July" opacity="1"/>
              <sld:ColorMapEntry color="#ff0800" quantity="8" label="August" opacity="1"/>
              <sld:ColorMapEntry color="#c20202" quantity="9" label="September" opacity="1"/>
              <sld:ColorMapEntry color="#8b0000" quantity="10" label="October" opacity="1"/>
              <sld:ColorMapEntry color="#0aa602" quantity="11" label="November" opacity="1"/>
              <sld:ColorMapEntry color="#83f27e" quantity="12" label="December" opacity="1"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>
