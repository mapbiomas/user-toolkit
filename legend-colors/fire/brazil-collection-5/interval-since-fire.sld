<?xml version="1.0" encoding="UTF-8"?>
<sld:StyledLayerDescriptor version="1.0.0"
    xmlns:sld="http://www.opengis.net/sld"
    xmlns:ogc="http://www.opengis.net/ogc"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.0.0/StyledLayerDescriptor.xsd">
  <sld:NamedLayer>
    <sld:Name>MapBiomas Fire brazil C5 - years since last fire</sld:Name>
    <sld:UserStyle>
      <sld:Name>MapBiomas Fire brazil C5 - years since last fire</sld:Name>
      <sld:FeatureTypeStyle>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#940000" quantity="1" label="1 year" opacity="1"/>
              <sld:ColorMapEntry color="#b51f16" quantity="2" label="2 years" opacity="1"/>
              <sld:ColorMapEntry color="#d63b24" quantity="3" label="3 years" opacity="1"/>
