              <sld:ColorMapEntry color="#8b318f" quantity="28" label="28 years" opacity="1"/>
              <sld:ColorMapEntry color="#9b2f8e" quantity="29" label="29 years" opacity="1"/>
              <sld:ColorMapEntry color="#aa318d" quantity="30" label="30 years" opacity="1"/>
              <sld:ColorMapEntry color="#b83b93" quantity="31" label="31 years" opacity="1"/>
              <sld:ColorMapEntry color="#c5489c" quantity="32" label="32 years" opacity="1"/>
              <sld:ColorMapEntry color="#d158a8" quantity="33" label="33 years" opacity="1"/>
              <sld:ColorMapEntry color="#dc6ab5" quantity="34" label="34 years" opacity="1"/>
              <sld:ColorMapEntry color="#e47bc0" quantity="35" label="35 years" opacity="1"/>
