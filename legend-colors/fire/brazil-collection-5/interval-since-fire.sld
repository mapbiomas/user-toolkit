              <sld:ColorMapEntry color="#e6df2a" quantity="9" label="9 years" opacity="1"/>
              <sld:ColorMapEntry color="#cde33a" quantity="10" label="10 years" opacity="1"/>
              <sld:ColorMapEntry color="#aee044" quantity="11" label="11 years" opacity="1"/>
              <sld:ColorMapEntry color="#8bd84f" quantity="12" label="12 years" opacity="1"/>
              <sld:ColorMapEntry color="#65cd5b" quantity="13" label="13 years" opacity="1"/>
              <sld:ColorMapEntry color="#42bf68" quantity="14" label="14 years" opacity="1"/>
              <sld:ColorMapEntry color="#2fb47a" quantity="15" label="15 years" opacity="1"/>
              <sld:ColorMapEntry color="#2aa98b" quantity="16" label="16 years" opacity="1"/>
              <sld:ColorMapEntry color="#35a4a0" quantity="17" label="17 years" opacity="1"/>
              <sld:ColorMapEntry color="#3aa0b8" quantity="18" label="18 years" opacity="1"/>
              <sld:ColorMapEntry color="#3696ca" quantity="19" label="19 years" opacity="1"/>
              <sld:ColorMapEntry color="#2f84c5" quantity="20" label="20 years" opacity="1"/>
              <sld:ColorMapEntry color="#2d6db7" quantity="21" label="21 years" opacity="1"/>
              <sld:ColorMapEntry color="#3159a8" quantity="22" label="22 years" opacity="1"/>
              <sld:ColorMapEntry color="#3d4d9d" quantity="23" label="23 years" opacity="1"/>
              <sld:ColorMapEntry color="#4b4597" quantity="24" label="24 years" opacity="1"/>
              <sld:ColorMapEntry color="#5b3f93" quantity="25" label="25 years" opacity="1"/>
