<?xml version="1.0" encoding="UTF-8"?>
<sld:StyledLayerDescriptor version="1.0.0"
    xmlns:sld="http://www.opengis.net/sld"
    xmlns:ogc="http://www.opengis.net/ogc"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.0.0/StyledLayerDescriptor.xsd">
  <sld:NamedLayer>
    <sld:Name>MapBiomas bolivia collection 3.0 - coverage</sld:Name>
    <sld:UserStyle>
      <sld:Name>MapBiomas bolivia collection 3.0 - coverage</sld:Name>
      <sld:FeatureTypeStyle>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#1f8d49" quantity="3" label="Forest" opacity="1"/>
              <sld:ColorMapEntry color="#7dc975" quantity="4" label="Open Forest" opacity="1"/>
              <sld:ColorMapEntry color="#026975" quantity="6" label="Flooded Forest" opacity="1"/>
              <sld:ColorMapEntry color="#519799" quantity="11" label="Flooded grassland/shrubland" opacity="1"/>
              <sld:ColorMapEntry color="#d6bc74" quantity="12" label="Grassland/shrubland" opacity="1"/>
              <sld:ColorMapEntry color="#d89f5c" quantity="13" label="Other non-forest natural formation" opacity="1"/>
              <sld:ColorMapEntry color="#edde8e" quantity="15" label="Pasture" opacity="1"/>
              <sld:ColorMapEntry color="#e974ed" quantity="18" label="Agriculture" opacity="1"/>
              <sld:ColorMapEntry color="#ffefc3" quantity="21" label="Mosaic of Uses" opacity="1"/>
              <sld:ColorMapEntry color="#ffa07a" quantity="23" label="Beach, dune and sandbank" opacity="1"/>
              <sld:ColorMapEntry color="#d4271e" quantity="24" label="Urban Infrastructure" opacity="1"/>
              <sld:ColorMapEntry color="#db4d4f" quantity="25" label="Other non-vegetated anthropic area" opacity="1"/>
              <sld:ColorMapEntry color="#ffaa5f" quantity="29" label="Rocky outcrop" opacity="1"/>
              <sld:ColorMapEntry color="#9c0027" quantity="30" label="Mining" opacity="1"/>
              <sld:ColorMapEntry color="#2532e4" quantity="33" label="River and lake" opacity="1"/>
              <sld:ColorMapEntry color="#93dfe6" quantity="34" label="Glacier" opacity="1"/>
              <sld:ColorMapEntry color="#f5b3c8" quantity="39" label="Soybean" opacity="1"/>
              <sld:ColorMapEntry color="#f5d5d5" quantity="61" label="Salt flat" opacity="1"/>
              <sld:ColorMapEntry color="#a89358" quantity="66" label="Scrubland" opacity="1"/>
              <sld:ColorMapEntry color="#e97a7a" quantity="68" label="Other non-vegetated natural area" opacity="1"/>
              <sld:ColorMapEntry color="#c1799c" quantity="72" label="Other crops" opacity="1"/>
              <sld:ColorMapEntry color="#c8c099" quantity="81" label="Andean grassland and shrubland" opacity="1"/>
              <sld:ColorMapEntry color="#66b2a3" quantity="82" label="Flooded Andean grassland and shrubland" opacity="1"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>
