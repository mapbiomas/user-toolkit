<?xml version="1.0" encoding="UTF-8"?>
<sld:StyledLayerDescriptor version="1.0.0"
    xmlns:sld="http://www.opengis.net/sld"
    xmlns:ogc="http://www.opengis.net/ogc"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.0.0/StyledLayerDescriptor.xsd">
  <sld:NamedLayer>
    <sld:Name>MapBiomas paraguay collection 3.0 - coverage</sld:Name>
    <sld:UserStyle>
      <sld:Name>MapBiomas paraguay collection 3.0 - coverage</sld:Name>
      <sld:FeatureTypeStyle>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#1f8d49" quantity="3" label="Closed Natural Woodlands" opacity="1"/>
              <sld:ColorMapEntry color="#7dc975" quantity="4" label="Open Natural Woodlands" opacity="1"/>
              <sld:ColorMapEntry color="#007785" quantity="6" label="Flooded Natural Woodlands" opacity="1"/>
              <sld:ColorMapEntry color="#7a6c00" quantity="9" label="Forest Plantation" opacity="1"/>
              <sld:ColorMapEntry color="#519799" quantity="11" label="Flooded grasslands" opacity="1"/>
              <sld:ColorMapEntry color="#d6bc74" quantity="12" label="Grassland" opacity="1"/>
              <sld:ColorMapEntry color="#edde8e" quantity="15" label="Pasture" opacity="1"/>
              <sld:ColorMapEntry color="#e974ed" quantity="18" label="Agriculture" opacity="1"/>
              <sld:ColorMapEntry color="#db4d4f" quantity="25" label="Non-vegetated area" opacity="1"/>
              <sld:ColorMapEntry color="#2532e4" quantity="33" label="Water body" opacity="1"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>
