<?xml version="1.0" encoding="UTF-8"?>
<sld:StyledLayerDescriptor version="1.0.0"
    xmlns:sld="http://www.opengis.net/sld"
    xmlns:ogc="http://www.opengis.net/ogc"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.0.0/StyledLayerDescriptor.xsd">
  <sld:NamedLayer>
    <sld:Name>MapBiomas uruguay collection 3.0 - coverage</sld:Name>
    <sld:UserStyle>
      <sld:Name>MapBiomas uruguay collection 3.0 - coverage</sld:Name>
      <sld:FeatureTypeStyle>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#1f8d49" quantity="3" label="Closed forest and closed shrubland" opacity="1"/>
              <sld:ColorMapEntry color="#519799" quantity="11" label="Flooded grasslands and swampy areas" opacity="1"/>
              <sld:ColorMapEntry color="#ccc87e" quantity="12" label="Grassland" opacity="1"/>
              <sld:ColorMapEntry color="#fbf0ab" quantity="15" label="Pasture" opacity="1"/>
              <sld:ColorMapEntry color="#c27ba0" quantity="18" label="Agriculture" opacity="1"/>
              <sld:ColorMapEntry color="#d4271e" quantity="22" label="Non-vegetated area" opacity="1"/>
              <sld:ColorMapEntry color="#2532e4" quantity="33" label="River, lake or ocean" opacity="1"/>
              <sld:ColorMapEntry color="#67671c" quantity="79" label="Pinus plantation" opacity="1"/>
              <sld:ColorMapEntry color="#886827" quantity="80" label="Eucalyptus plantation" opacity="1"/>
              <sld:ColorMapEntry color="#ab8231" quantity="83" label="Other forestry uses" opacity="1"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>
