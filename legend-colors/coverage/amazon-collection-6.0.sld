<?xml version="1.0" encoding="UTF-8"?>
<sld:StyledLayerDescriptor version="1.0.0"
    xmlns:sld="http://www.opengis.net/sld"
    xmlns:ogc="http://www.opengis.net/ogc"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.0.0/StyledLayerDescriptor.xsd">
  <sld:NamedLayer>
    <sld:Name>MapBiomas amazon collection 6.0 - coverage</sld:Name>
    <sld:UserStyle>
      <sld:Name>MapBiomas amazon collection 6.0 - coverage</sld:Name>
      <sld:FeatureTypeStyle>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#1f8d49" quantity="3" label="Forest formation" opacity="1"/>
              <sld:ColorMapEntry color="#7dc975" quantity="4" label="Savanna formation / Open forest" opacity="1"/>
              <sld:ColorMapEntry color="#04381d" quantity="5" label="Mangrove" opacity="1"/>
              <sld:ColorMapEntry color="#026975" quantity="6" label="Flooded forest" opacity="1"/>
              <sld:ColorMapEntry color="#7a5900" quantity="9" label="Silviculture" opacity="1"/>
              <sld:ColorMapEntry color="#519799" quantity="11" label="Flooded grassland / Shrubland" opacity="1"/>
              <sld:ColorMapEntry color="#d6bc74" quantity="12" label="Grassland" opacity="1"/>
              <sld:ColorMapEntry color="#d89f5c" quantity="13" label="Other non-forest natural formation" opacity="1"/>
              <sld:ColorMapEntry color="#edde8e" quantity="15" label="Pasture" opacity="1"/>
              <sld:ColorMapEntry color="#e974ed" quantity="18" label="Agriculture" opacity="1"/>
              <sld:ColorMapEntry color="#ffefc3" quantity="21" label="Mosaic of uses" opacity="1"/>
              <sld:ColorMapEntry color="#ffa07a" quantity="23" label="Beach, dune and sand spot" opacity="1"/>
              <sld:ColorMapEntry color="#d4271e" quantity="24" label="Urban infrastructure" opacity="1"/>
              <sld:ColorMapEntry color="#db4d4f" quantity="25" label="Other anthropic non-vegetated area" opacity="1"/>
              <sld:ColorMapEntry color="#ffffff" quantity="27" label="Not observed" opacity="1"/>
              <sld:ColorMapEntry color="#ffaa5f" quantity="29" label="Rock outcrop" opacity="1"/>
              <sld:ColorMapEntry color="#9c0027" quantity="30" label="Mining" opacity="1"/>
              <sld:ColorMapEntry color="#2532e4" quantity="33" label="River, lake and ocean" opacity="1"/>
              <sld:ColorMapEntry color="#93dfe6" quantity="34" label="Glacier" opacity="1"/>
              <sld:ColorMapEntry color="#9065d0" quantity="35" label="Oil palm" opacity="1"/>
              <sld:ColorMapEntry color="#e97a7a" quantity="68" label="Other natural non-vegetated area" opacity="1"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>
