<?xml version="1.0" encoding="UTF-8"?>
<sld:StyledLayerDescriptor version="1.0.0"
    xmlns:sld="http://www.opengis.net/sld"
    xmlns:ogc="http://www.opengis.net/ogc"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.0.0/StyledLayerDescriptor.xsd">
  <sld:NamedLayer>
    <sld:Name>MapBiomas colombia collection 3.0 - coverage</sld:Name>
    <sld:UserStyle>
      <sld:Name>MapBiomas colombia collection 3.0 - coverage</sld:Name>
      <sld:FeatureTypeStyle>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#1f8d49" quantity="3" label="Forest" opacity="1"/>
              <sld:ColorMapEntry color="#04381d" quantity="5" label="Mangrove" opacity="1"/>
              <sld:ColorMapEntry color="#026975" quantity="6" label="Flooded forest" opacity="1"/>
              <sld:ColorMapEntry color="#7a5900" quantity="9" label="Forest plantation" opacity="1"/>
              <sld:ColorMapEntry color="#519799" quantity="11" label="Wetland" opacity="1"/>
              <sld:ColorMapEntry color="#d6bc74" quantity="12" label="Grasslands / herbaceous" opacity="1"/>
              <sld:ColorMapEntry color="#d89f5c" quantity="13" label="Other non forest formation" opacity="1"/>
              <sld:ColorMapEntry color="#ffefc3" quantity="21" label="Mosaic of agriculture and pasture" opacity="1"/>
              <sld:ColorMapEntry color="#ffa07a" quantity="23" label="Beach, dune and sand spot" opacity="1"/>
              <sld:ColorMapEntry color="#d4271e" quantity="24" label="Infrastructure" opacity="1"/>
              <sld:ColorMapEntry color="#db4d4f" quantity="25" label="Other non-vegetated area" opacity="1"/>
              <sld:ColorMapEntry color="#ffaa5f" quantity="29" label="Rocky outcrop" opacity="1"/>
              <sld:ColorMapEntry color="#9c0027" quantity="30" label="Mining" opacity="1"/>
              <sld:ColorMapEntry color="#091077" quantity="31" label="Aquaculture" opacity="1"/>
              <sld:ColorMapEntry color="#fc8114" quantity="32" label="Hypersaline tidal flat" opacity="1"/>
              <sld:ColorMapEntry color="#2532e4" quantity="33" label="River, lake or ocean" opacity="1"/>
              <sld:ColorMapEntry color="#93dfe6" quantity="34" label="Glacier" opacity="1"/>
              <sld:ColorMapEntry color="#9065d0" quantity="35" label="Palm oil" opacity="1"/>
              <sld:ColorMapEntry color="#02d659" quantity="49" label="Wooded sand vegetation" opacity="1"/>
              <sld:ColorMapEntry color="#ad5100" quantity="50" label="Herbaceous sand vegetation" opacity="1"/>
              <sld:ColorMapEntry color="#e97a7a" quantity="68" label="Other natural  non-vegetated area" opacity="1"/>
              <sld:ColorMapEntry color="#be83f7" quantity="74" label="Banana" opacity="1"/>
              <sld:ColorMapEntry color="#dfeb62" quantity="81" label="Andinean Herbaceous and Shrubby Vegetation" opacity="1"/>
              <sld:ColorMapEntry color="#6fc179" quantity="82" label="Flooded Andinean Herbaceous and Shrubby Vegetation" opacity="1"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>
