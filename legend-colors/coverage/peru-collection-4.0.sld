<?xml version="1.0" encoding="UTF-8"?>
<sld:StyledLayerDescriptor version="1.0.0"
    xmlns:sld="http://www.opengis.net/sld"
    xmlns:ogc="http://www.opengis.net/ogc"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.0.0/StyledLayerDescriptor.xsd">
  <sld:NamedLayer>
    <sld:Name>MapBiomas peru collection 4.0 - coverage</sld:Name>
    <sld:UserStyle>
      <sld:Name>MapBiomas peru collection 4.0 - coverage</sld:Name>
      <sld:FeatureTypeStyle>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#1f8d49" quantity="3" label="Forest" opacity="1"/>
              <sld:ColorMapEntry color="#7dc975" quantity="4" label="Dry Forest" opacity="1"/>
              <sld:ColorMapEntry color="#04381d" quantity="5" label="Mangrove" opacity="1"/>
              <sld:ColorMapEntry color="#026975" quantity="6" label="Flooded forest" opacity="1"/>
              <sld:ColorMapEntry color="#7a5900" quantity="9" label="Planted forest" opacity="1"/>
              <sld:ColorMapEntry color="#d6bc74" quantity="12" label="Herbaceous Formation" opacity="1"/>
              <sld:ColorMapEntry color="#edde8e" quantity="15" label="Pasture (beta)" opacity="1"/>
              <sld:ColorMapEntry color="#ffefc3" quantity="21" label="Agricultural and livestock mosaic" opacity="1"/>
              <sld:ColorMapEntry color="#ffa07a" quantity="23" label="Beach" opacity="1"/>
              <sld:ColorMapEntry color="#d4271e" quantity="24" label="Urban area" opacity="1"/>
              <sld:ColorMapEntry color="#db4d4f" quantity="25" label="Other anthropic non vegetated area" opacity="1"/>
              <sld:ColorMapEntry color="#9c0027" quantity="30" label="Mining" opacity="1"/>
              <sld:ColorMapEntry color="#091077" quantity="31" label="Aquaculture" opacity="1"/>
              <sld:ColorMapEntry color="#2532e4" quantity="33" label="River, lake or ocean" opacity="1"/>
              <sld:ColorMapEntry color="#93dfe6" quantity="34" label="Glacier" opacity="1"/>
              <sld:ColorMapEntry color="#9065d0" quantity="35" label="Oil Palm" opacity="1"/>
              <sld:ColorMapEntry color="#c71585" quantity="40" label="Rice (beta)" opacity="1"/>
              <sld:ColorMapEntry color="#5faf92" quantity="51" label="Lowland Flooded Grassland" opacity="1"/>
              <sld:ColorMapEntry color="#f0b4a8" quantity="52" label="Coastal salt flat surface" opacity="1"/>
              <sld:ColorMapEntry color="#f5d5d5" quantity="61" label="Salt flat surface" opacity="1"/>
              <sld:ColorMapEntry color="#a89358" quantity="66" label="Shrubland and Other Shrub Formations" opacity="1"/>
              <sld:ColorMapEntry color="#e97a7a" quantity="68" label="Other natural non vegetated area" opacity="1"/>
              <sld:ColorMapEntry color="#be9e00" quantity="70" label="Coastal Lomas (beta)" opacity="1"/>
              <sld:ColorMapEntry color="#26abab" quantity="82" label="High Andean Flooded Grassland" opacity="1"/>
              <sld:ColorMapEntry color="#d98a45" quantity="92" label="Rocky surface" opacity="1"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>
