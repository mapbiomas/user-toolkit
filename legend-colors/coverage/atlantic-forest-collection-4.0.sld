<?xml version="1.0" encoding="UTF-8"?>
<sld:StyledLayerDescriptor version="1.0.0"
    xmlns:sld="http://www.opengis.net/sld"
    xmlns:ogc="http://www.opengis.net/ogc"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.0.0/StyledLayerDescriptor.xsd">
  <sld:NamedLayer>
    <sld:Name>MapBiomas atlantic-forest collection 4.0 - coverage</sld:Name>
    <sld:UserStyle>
      <sld:Name>MapBiomas atlantic-forest collection 4.0 - coverage</sld:Name>
      <sld:FeatureTypeStyle>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#1f8d49" quantity="3" label="Forest Formation" opacity="1"/>
              <sld:ColorMapEntry color="#7dc975" quantity="4" label="Savanna Formation" opacity="1"/>
              <sld:ColorMapEntry color="#04381d" quantity="5" label="Mangrove" opacity="1"/>
              <sld:ColorMapEntry color="#7a5900" quantity="9" label="Forest Plantation" opacity="1"/>
              <sld:ColorMapEntry color="#519799" quantity="11" label="Flooded grasslands" opacity="1"/>
              <sld:ColorMapEntry color="#d6bc74" quantity="12" label="Grassland" opacity="1"/>
              <sld:ColorMapEntry color="#edde8e" quantity="15" label="Pasture" opacity="1"/>
              <sld:ColorMapEntry color="#c27ba0" quantity="19" label="Annual Crops" opacity="1"/>
              <sld:ColorMapEntry color="#ffefc3" quantity="21" label="Mosaic of Uses" opacity="1"/>
              <sld:ColorMapEntry color="#d4271e" quantity="22" label="Non vegetated area" opacity="1"/>
              <sld:ColorMapEntry color="#ffffff" quantity="27" label="Not Observed" opacity="1"/>
              <sld:ColorMapEntry color="#ffaa5f" quantity="29" label="Rocky Outcrop" opacity="1"/>
              <sld:ColorMapEntry color="#091077" quantity="31" label="Aquaculture" opacity="1"/>
              <sld:ColorMapEntry color="#fc8114" quantity="32" label="Hypersaline Tidal Flat" opacity="1"/>
              <sld:ColorMapEntry color="#2532e4" quantity="33" label="River, Lake and Ocean" opacity="1"/>
              <sld:ColorMapEntry color="#d68fe2" quantity="46" label="Coffee" opacity="1"/>
              <sld:ColorMapEntry color="#e6ccff" quantity="48" label="Other Perennial Crops" opacity="1"/>
              <sld:ColorMapEntry color="#02d659" quantity="49" label="Wooded Sandbank Vegetation" opacity="1"/>
              <sld:ColorMapEntry color="#ad5100" quantity="50" label="Herbaceous Sandbank Vegetation" opacity="1"/>
              <sld:ColorMapEntry color="#b9158a" quantity="65" label="Tea" opacity="1"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>
