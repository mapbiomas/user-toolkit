<?xml version="1.0" encoding="UTF-8"?>
<sld:StyledLayerDescriptor version="1.0.0"
    xmlns:sld="http://www.opengis.net/sld"
    xmlns:ogc="http://www.opengis.net/ogc"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.0.0/StyledLayerDescriptor.xsd">
  <sld:NamedLayer>
    <sld:Name>MapBiomas mexico collection 1.0 - coverage</sld:Name>
    <sld:UserStyle>
      <sld:Name>MapBiomas mexico collection 1.0 - coverage</sld:Name>
      <sld:FeatureTypeStyle>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#1f8d49" quantity="3" label="Tropical humid forest" opacity="1"/>
              <sld:ColorMapEntry color="#04381d" quantity="5" label="Mangrove" opacity="1"/>
              <sld:ColorMapEntry color="#7a5900" quantity="9" label="Forest plantation" opacity="1"/>
              <sld:ColorMapEntry color="#519799" quantity="11" label="Flooded" opacity="1"/>
              <sld:ColorMapEntry color="#edde8e" quantity="15" label="Cultivated grassland" opacity="1"/>
              <sld:ColorMapEntry color="#c27ba0" quantity="19" label="Annual crop" opacity="1"/>
              <sld:ColorMapEntry color="#d4271e" quantity="24" label="Urban and built-up area" opacity="1"/>
              <sld:ColorMapEntry color="#db4d4f" quantity="25" label="Other non-vegetated areas" opacity="1"/>
              <sld:ColorMapEntry color="#2532e4" quantity="33" label="River, lake or ocean" opacity="1"/>
              <sld:ColorMapEntry color="#93dfe6" quantity="34" label="Ice and permanent snow" opacity="1"/>
              <sld:ColorMapEntry color="#d082de" quantity="36" label="Perennial crop" opacity="1"/>
              <sld:ColorMapEntry color="#807a40" quantity="45" label="Savanna and natural grassland" opacity="1"/>
              <sld:ColorMapEntry color="#a89358" quantity="66" label="Shrublands" opacity="1"/>
              <sld:ColorMapEntry color="#329c5a" quantity="88" label="Temperate forest" opacity="1"/>
              <sld:ColorMapEntry color="#6bd46c" quantity="89" label="Tropical dry forest" opacity="1"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>
