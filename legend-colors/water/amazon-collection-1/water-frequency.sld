<?xml version="1.0" encoding="UTF-8"?>
<sld:StyledLayerDescriptor version="1.0.0"
    xmlns:sld="http://www.opengis.net/sld"
    xmlns:ogc="http://www.opengis.net/ogc"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.0.0/StyledLayerDescriptor.xsd">
  <sld:NamedLayer>
    <sld:Name>MapBiomas Water amazon C1 - water frequency</sld:Name>
    <sld:UserStyle>
      <sld:Name>MapBiomas Water amazon C1 - water frequency</sld:Name>
      <sld:FeatureTypeStyle>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#e5e5ff" quantity="1" label="Water in 1 year" opacity="1"/>
              <sld:ColorMapEntry color="#e5e5ff" quantity="2" label="Water in 2 years" opacity="1"/>
              <sld:ColorMapEntry color="#ccccff" quantity="3" label="Water in 3 years" opacity="1"/>
              <sld:ColorMapEntry color="#ccccff" quantity="4" label="Water in 4 years" opacity="1"/>
              <sld:ColorMapEntry color="#ccccff" quantity="5" label="Water in 5 years" opacity="1"/>
              <sld:ColorMapEntry color="#ccccff" quantity="6" label="Water in 6 years" opacity="1"/>
              <sld:ColorMapEntry color="#b2b2ff" quantity="7" label="Water in 7 years" opacity="1"/>
              <sld:ColorMapEntry color="#b2b2ff" quantity="8" label="Water in 8 years" opacity="1"/>
              <sld:ColorMapEntry color="#b2b2ff" quantity="9" label="Water in 9 years" opacity="1"/>
              <sld:ColorMapEntry color="#b2b2ff" quantity="10" label="Water in 10 years" opacity="1"/>
              <sld:ColorMapEntry color="#9999ff" quantity="11" label="Water in 11 years" opacity="1"/>
              <sld:ColorMapEntry color="#9999ff" quantity="12" label="Water in 12 years" opacity="1"/>
              <sld:ColorMapEntry color="#9999ff" quantity="13" label="Water in 13 years" opacity="1"/>
              <sld:ColorMapEntry color="#9999ff" quantity="14" label="Water in 14 years" opacity="1"/>
              <sld:ColorMapEntry color="#7f7fff" quantity="15" label="Water in 15 years" opacity="1"/>
              <sld:ColorMapEntry color="#7f7fff" quantity="16" label="Water in 16 years" opacity="1"/>
              <sld:ColorMapEntry color="#7f7fff" quantity="17" label="Water in 17 years" opacity="1"/>
              <sld:ColorMapEntry color="#7f7fff" quantity="18" label="Water in 18 years" opacity="1"/>
              <sld:ColorMapEntry color="#6666ff" quantity="19" label="Water in 19 years" opacity="1"/>
              <sld:ColorMapEntry color="#6666ff" quantity="20" label="Water in 20 years" opacity="1"/>
              <sld:ColorMapEntry color="#6666ff" quantity="21" label="Water in 21 years" opacity="1"/>
              <sld:ColorMapEntry color="#6666ff" quantity="22" label="Water in 22 years" opacity="1"/>
              <sld:ColorMapEntry color="#4c4cff" quantity="23" label="Water in 23 years" opacity="1"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>
