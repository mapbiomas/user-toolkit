<?xml version="1.0" encoding="UTF-8"?>
<sld:StyledLayerDescriptor version="1.0.0"
    xmlns:sld="http://www.opengis.net/sld"
    xmlns:ogc="http://www.opengis.net/ogc"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.opengis.net/sld http://schemas.opengis.net/sld/1.0.0/StyledLayerDescriptor.xsd">
  <sld:NamedLayer>
    <sld:Name>MapBiomas Degradation brazil C10.1 - canopy disturbance frequency</sld:Name>
    <sld:UserStyle>
      <sld:Name>MapBiomas Degradation brazil C10.1 - canopy disturbance frequency</sld:Name>
      <sld:FeatureTypeStyle>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#440154" quantity="1" label="1 time" opacity="1"/>
              <sld:ColorMapEntry color="#482172" quantity="2" label="2 times" opacity="1"/>
              <sld:ColorMapEntry color="#423d84" quantity="3" label="3 times" opacity="1"/>
              <sld:ColorMapEntry color="#38578c" quantity="4" label="4 times" opacity="1"/>
              <sld:ColorMapEntry color="#2d6f8e" quantity="5" label="5 times" opacity="1"/>
              <sld:ColorMapEntry color="#24858d" quantity="6" label="6 times" opacity="1"/>
              <sld:ColorMapEntry color="#1e9a89" quantity="7" label="7 times" opacity="1"/>
              <sld:ColorMapEntry color="#2ab07e" quantity="8" label="8 times" opacity="1"/>
              <sld:ColorMapEntry color="#51c468" quantity="9" label="9 times" opacity="1"/>
              <sld:ColorMapEntry color="#86d449" quantity="10" label="10 times" opacity="1"/>
              <sld:ColorMapEntry color="#c2df22" quantity="11" label="11 times" opacity="1"/>
              <sld:ColorMapEntry color="#fde724" quantity="12" label="12 times" opacity="1"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>
